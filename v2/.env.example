# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 등록되어 있어 커밋되지 않습니다.

# [필수] Discord 웹훅 URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000/xxxxxxxx

# [선택] 오픈 알림에 붙일 멘션. 예: @everyone
DISCORD_MENTION=

# [선택] 예매 가능 일자 폴링 주기(초). 새 날짜 감지 속도를 결정한다.
CGV_FAST_INTERVAL=5

# [선택] 회차 스윕 주기(초). 이미 열린 날짜에 회차가 추가되는 경우를 잡는다.
CGV_SWEEP_INTERVAL=60

# [선택] 스윕 동시 요청 수. 높이면 차단 위험이 커진다.
CGV_SWEEP_CONCURRENCY=3

# [선택] 생존 신고를 보낼 시각(0~23). -1이면 보내지 않는다.
CGV_HEARTBEAT_HOUR=9
